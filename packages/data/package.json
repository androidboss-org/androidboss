{
  "name": "@androidboss/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./permissions": "./src/permissions.ts",
    "./target-sdk": "./src/target-sdk.ts",
    "./plist-keys": "./src/plist-keys.ts",
    "./prompt-recipes": "./src/prompt-recipes.ts",
    "./official-skills": "./src/official-skills.ts",
    "./kmp-libraries": "./src/kmp-libraries.ts",
    "./privacy": "./src/privacy.ts",
    "./latest-versions": "./src/latest-versions.ts",
    "./versions": "./src/versions.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:gradle": "CHECK_GRADLE=1 vitest run src/kmp-libraries.gradle.test.ts src/latest-versions.gradle.test.ts",
    "update:latest": "node --experimental-strip-types scripts/update-latest-versions.mts",
    "update:kmp": "node --experimental-strip-types scripts/update-kmp-libraries.mts",
    "watch:versions": "node --experimental-strip-types scripts/version-watch.mts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  }
}
